{
  "manifest_version": 3,
  "name": "dydownload Cookie Helper",
  "version": "1.0.0",
  "description": "将抖音和 B 站 Cookie 安全传递给本机 dydownload 下载工具",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.iesdouyin.com/*",
    "*://*.douyinvod.com/*",
    "*://*.bilibili.com/*",
    "*://*.b23.tv/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "dydownload - 获取 Cookie"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*",
        "*://*.bilibili.com/*",
        "*://*.b23.tv/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
